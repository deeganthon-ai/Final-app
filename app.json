{
  "expo": {
    "name": "HomeFit Pro",
    "slug": "homefit-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./Icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07101f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": false },
    "android": {
      "package": "com.deeganthon.homefitpro",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./Icon.png",
        "backgroundColor": "#07101f"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow HomeFit Pro to scan food barcodes." }]
    ],
    "extra": {
      "eas": {
        "projectId": "3e2df639-fc8a-4fea-a664-7aff3d61b3c7"
      }
    }
  }
}
